# Copy to webapp/.env.local (git-ignored) and restart `npm run dev`.
# Nothing in here is ever sent to the browser: only /api/alerts reads it.

# --- The model that actually detects things ---------------------------------
# Without these, uploads save but nothing analyses them: the "Run AI analysis"
# option only appears when /api/model reports a model.
# Hosted, easiest to demo with:
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_API_KEY=sk-or-...
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Or on the GB10, which is where this is supposed to run:
# VLM_BASE_URL=http://localhost:8000/v1
# VLM_MODEL=<the name your server serves>
# Offer more than one in Preferences:
# VLM_MODEL_OPTIONS=qwen/qwen3-vl-30b-a3b-instruct,another/model

# --- Twilio, for owner SMS alerts -------------------------------------------
# Console > Account Info. Shravan's account holds the $20 hackathon credit.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# One of these two. A Messaging Service wins if both are set.
TWILIO_FROM_NUMBER=+15005550006
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Who gets the text. E.164 only.
# On a Twilio trial this must be a number verified in the console, and texts to
# US numbers additionally need A2P 10DLC or toll-free verification. If that
# clearance has not come through by demo day, the WhatsApp sandbox is the
# fallback: set TWILIO_FROM_NUMBER=whatsapp:+14155238886 and prefix this with
# whatsapp: too.
ALERT_OWNER_NUMBER=+14085551234

# WhatsApp. The sandbox sender is +14155238886; each recipient must first send
# the join code to it from their own WhatsApp.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email, through SendGrid (Twilio owns it, but it is a separate key and the
# sender address has to be verified in the SendGrid console).
# SENDGRID_API_KEY=SG....
# ALERT_EMAIL_FROM=alerts@yourdomain.com

# --- Alert policy -----------------------------------------------------------
# Severity floor. Gun, robbery and medical emergency always text regardless.
ALERT_MIN_SEVERITY=high
ALERT_MAX_PER_HOUR=10
# Absolute base for the review link in the text. Defaults to the request origin,
# which is wrong once the dashboard is reached over the LAN, so set it on the ZGX.
# ALERT_REVIEW_BASE=http://zgx.local:3000

# --- Callers ----------------------------------------------------------------
# The dashboard is allowed by same-origin. A detection service posting from the
# ZGX presents this in the x-alert-token header instead.
# ALERT_API_TOKEN=

# A recording can opt in to its own recipient on the upload page. That means the
# browser names the destination, which is an open relay if this app is ever
# reachable beyond localhost. Set this to false before exposing it anywhere.
# ALERT_ALLOW_CLIENT_RECIPIENT=false

# Point Twilio's REST base somewhere else so tests and demos cost nothing.
# TWILIO_API_BASE=http://127.0.0.1:4010

# Hermes watch agent (webapp/.plans/hermes-watch-agent.md). ops/hermes/setup.sh generates it.
# When set, the server logs every analysed window, review and alert to ../data/watch/ and
# serves /api/mcp to the agent, which must present this token. Unset = no feed log, no agent.
# WATCH_AGENT_TOKEN=
# WATCH_DATA_DIR=            # default ../data/watch
